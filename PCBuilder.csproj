<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- exe、工作列、Alt+Tab 的圖示（視窗沒有另外設定 Icon 時沿用它）；由 Assets\build-icon.ps1 產生 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />

    <!-- UI -->
    <!-- 固定版本：浮動的 4.* 會讓不同時間建置拿到不同版本，畫面可能在沒改程式的情況下改變 -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />

    <!-- Data -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />

    <!-- HTTP -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />

    <!-- DI + Hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />

    <!-- Hardware -->
    <PackageReference Include="System.Management" Version="10.0.12" />
    <!-- 0.9.5 起改用 PawnIO 讀取 CPU 溫度等底層感測器（不再內含有已知漏洞的 WinRing0 驅動），使用者需另外安裝 PawnIO -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- 商品沒有圖片或圖片載入失敗時的替代圖 -->
    <Resource Include="Assets\no-image.jpg" />
    <!-- 菜單管理頁可以拖曳的項目上顯示的張開手掌游標；由 Assets\build-icon.ps1 產生 -->
    <Resource Include="Assets\grab.cur" />
  </ItemGroup>

</Project>
