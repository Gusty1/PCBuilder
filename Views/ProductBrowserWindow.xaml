<ui:FluentWindow x:Class="PCBuilder.Views.ProductBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="網頁" Height="820" Width="1100" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" Title="網頁" />

        <!-- 工具列：上一頁／下一頁／重新整理、目前網址、用外部瀏覽器開啟 -->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button x:Name="BackButton" Grid.Column="0" Icon="{ui:SymbolIcon ArrowLeft24}" ToolTip="上一頁"
                       Appearance="Transparent" IsEnabled="False" Click="Back_Click" />
            <ui:Button x:Name="ForwardButton" Grid.Column="1" Icon="{ui:SymbolIcon ArrowRight24}" ToolTip="下一頁"
                       Appearance="Transparent" IsEnabled="False" Margin="4,0,0,0" Click="Forward_Click" />
            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon ArrowClockwise24}" ToolTip="重新整理"
                       Appearance="Transparent" Margin="4,0,0,0" Click="Reload_Click" />
            <ui:ProgressRing x:Name="LoadingRing" Grid.Column="3" IsIndeterminate="True" Width="16" Height="16"
                             Margin="12,0,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="AddressText" Grid.Column="4" Margin="12,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Opacity="0.7" />
            <ui:Button Grid.Column="5" Content="用瀏覽器開啟" Icon="{ui:SymbolIcon Open24}" Click="OpenInBrowser_Click" />
        </Grid>

        <wv2:WebView2 x:Name="WebView" Grid.Row="2" />
    </Grid>
</ui:FluentWindow>
