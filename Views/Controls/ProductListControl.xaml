<UserControl x:Class="PCBuilder.Views.Controls.ProductListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TextBox Grid.Row="0" x:Name="SearchBox" PlaceholderText="搜尋商品"
                    Icon="{ui:SymbolIcon Search24}" Margin="0,0,0,8" MaxWidth="300" HorizontalAlignment="Left"
                    TextChanged="SearchBox_TextChanged" />

        <ListView Grid.Row="1" x:Name="ProductListView" ItemsSource="{Binding Products, ElementName=Root}"
                  BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="商品名稱" Width="480">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" MaxWidth="420" />
                                        <ui:SymbolIcon Symbol="Fire24" Margin="6,0,0,0"
                                                       Visibility="{Binding IsHot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Group}" Opacity="0.6" FontSize="12"
                                               Visibility="{Binding Group, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="價格" DisplayMemberBinding="{Binding Price}" Width="100" />
                    <GridViewColumn Header="數量" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ui:NumberBox Value="{Binding Qty, Mode=TwoWay}" Width="80" Minimum="0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
