<UserControl x:Class="PCBuilder.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PCBuilder.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MenuViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="新增菜單" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddNewMenuCommand}" />
            <TextBlock Text="生成估價單為實驗性功能，不保證可套用至原價屋網站"
                       Opacity="0.6" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Menus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander Margin="0,0,0,12" IsExpanded="True">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Background="Green" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="已送出" Foreground="White" FontSize="11" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Icon="{ui:SymbolIcon Open24}" ToolTip="開啟估價網頁"
                                                   Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding HtmUrl}"
                                                   Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Image24}" ToolTip="開啟估價圖片" Margin="4,0,0,0"
                                                   Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding PngUrl}"
                                                   Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <ui:Button Icon="{ui:SymbolIcon Edit24}" ToolTip="編輯" Margin="4,0,0,0"
                                                   Command="{Binding DataContext.StartEditingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="刪除菜單" Appearance="Danger" Margin="4,0,0,0"
                                                   Command="{Binding DataContext.DeleteMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding MyMenuProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding Key}" IsExpanded="True" Margin="0,4">
                                                <ItemsControl ItemsSource="{Binding Value}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding ProductPrice, StringFormat=N0}" Margin="8,0" />
                                                                <ui:NumberBox Grid.Column="2" Value="{Binding Qty, Mode=TwoWay}" Width="75" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Margin="0,8" />

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ReviseDate, StringFormat='最後修改: {0:yyyy/MM/dd HH:mm}'}" Opacity="0.6" />
                                    <ui:Button Content="生成估價單" Icon="{ui:SymbolIcon Send24}" Margin="12,0,0,0"
                                               HorizontalAlignment="Right"
                                               Command="{Binding DataContext.SendMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding Id}"
                                               Visibility="{Binding IsSend, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
