<Page x:Class="PCBuilder.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PCBuilder.ViewModels"
             xmlns:views="clr-namespace:PCBuilder.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MenuViewModel}"
             d:DesignHeight="800" d:DesignWidth="1200"
             ScrollViewer.CanContentScroll="False"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- CanContentScroll=False：WPF-UI 會依這個值決定是否把頁面包進它的捲動容器；包起來時頁面高度無限，
         裡面的 ScrollViewer 以為內容都塞得下而不能捲，滑鼠滾輪又被它吃掉，外層的捲軸也滾不動。
         Foreground：頁面裡沒有包在 WPF-UI 控制項內的文字不會繼承主題文字色，深色模式下會變成預設的黑字 -->

    <Page.Resources>
        <!-- 拖曳時跟著滑鼠的半透明小卡片：菜單商品（MenuProduct）與暫存區商品（StagedProduct）的欄位名稱相同，共用這個範本。
             卡片畫在視窗的裝飾層、不在頁面裡，文字顏色要自己指定，深色模式才不會是黑字 -->
        <DataTemplate x:Key="DragPreviewTemplate">
            <Border Width="260" Padding="10,8" CornerRadius="6" BorderThickness="1.5" Opacity="0.75"
                    Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.7" />
                    <TextBlock Text="{Binding ProductName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,2,0,0" />
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="{Binding ProductPrice, Mode=OneWay, StringFormat='${0:N0}'}" FontWeight="SemiBold" />
                        <Run Text="{Binding Qty, Mode=OneWay, StringFormat='  × {0}'}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 可拖曳的列與卡片上是手掌游標，裡面的按鈕維持一般箭頭，才看得出按鈕是用點的、不是用拖的 -->
        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Page.Resources>

    <!-- PageRoot：拖曳預覽卡片掛在它的裝飾層，座標也以它為準 -->
    <Grid x:Name="PageRoot" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="新增菜單" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddNewMenuCommand}" />
            <TextBlock Text="修改會自動儲存；生成估價單後就不能再修改（生成估價單為實驗性功能，不保證可套用至原價屋網站）"
                       Opacity="0.6" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 零件暫存區：接受從菜單拖過來的商品；拖曳菜單商品時外框變強調色，提示可以放在這裡 -->
        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" CornerRadius="8" Padding="12" AllowDrop="True"
                PreviewDragOver="StagingArea_PreviewDragOver" PreviewDrop="StagingArea_PreviewDrop">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDraggingMenuItem}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter Property="BorderThickness" Value="2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="零件暫存區" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StagedProducts.Count, StringFormat='（{0}）'}" Opacity="0.7" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Row="1" Text="把菜單裡的商品拖到這裡暫存，再拖回右邊的菜單就能放回（已生成估價單的菜單除外）"
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,6,0,10" />

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasStagedProducts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="32" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="暫存區是空的" Opacity="0.6" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StagedProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 整張卡片都能拖曳（按鈕、商品連結除外），拖到右邊的菜單放回 -->
                                <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="8" Margin="0,0,0,8" ToolTip="拖曳到右邊的菜單即可放回"
                                        Cursor="{x:Static views:MenuView.GrabCursor}"
                                        PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown" MouseMove="DragSource_MouseMove">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="ReOrderDotsVertical24" Opacity="0.4" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" Opacity="0.6" />
                                            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                                <Hyperlink Style="{StaticResource ProductLinkStyle}"
                                                           Command="{Binding DataContext.OpenProductLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                                    <Run Text="{Binding ProductName, Mode=OneWay}" />
                                                </Hyperlink>
                                            </TextBlock>
                                            <TextBlock Margin="0,4,0,0">
                                                <Run Text="{Binding ProductPrice, Mode=OneWay, StringFormat='${0:N0}'}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Qty, Mode=OneWay, StringFormat='  × {0}'}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <ui:Button Icon="{ui:SymbolIcon ArrowExportLtr24}" ToolTip="放回菜單"
                                                       AutomationProperties.Name="放回菜單" Click="ReturnToMenu_Click" />
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="從暫存區刪除" AutomationProperties.Name="從暫存區刪除"
                                                       Appearance="Danger" Margin="0,4,0,0"
                                                       Command="{Binding DataContext.DeleteStagedCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasMenus, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="40" Opacity="0.5" />
            <TextBlock Text="尚未建立任何菜單" FontSize="16" Opacity="0.7" Margin="0,12,0,4" HorizontalAlignment="Center" />
            <TextBlock Text="點擊上方「新增菜單」按鈕開始建立" Opacity="0.5" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- SizeChanged：依清單寬度決定菜單標題列是否改成兩行（IsCompactMenuHeader） -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" SizeChanged="MenuList_SizeChanged">
            <ItemsControl ItemsSource="{Binding Menus}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 外框：接受從零件暫存區拖過來的商品（菜單之間不能互相拖曳）；拖曳暫存區商品時，可以放入的菜單外框變強調色 -->
                        <Border Margin="0,0,0,12" CornerRadius="10" BorderThickness="2" AllowDrop="True"
                                PreviewDragOver="MenuCard_PreviewDragOver" PreviewDrop="MenuCard_PreviewDrop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.IsDraggingStagedItem, RelativeSource={RelativeSource AncestorType=Page}}" Value="True" />
                                                <Condition Binding="{Binding IsSend}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- 每個菜單一個代表色：CardExpander 的 Background 只套用在標題列（內容區固定卡片底色），標題最左邊放同色色條。
                                 色條不能放 CardExpander.Icon：WPF-UI 4 的 Icon 型別是 IconElement，放 Border 會 XamlParseException 閃退 -->
                            <!-- 預設收合；IsExpanded 雙向綁定到 DTO，重新載入清單時 MenuViewModel 會保留原本的展開狀態 -->
                            <ui:CardExpander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                             Background="{Binding Id, Converter={StaticResource MenuColorConverter}, ConverterParameter=Tint}">
                                <ui:CardExpander.Header>
                                    <!-- 第二列平常是空的；清單太窄時摘要移到這一列（名稱下面） -->
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Grid.RowSpan="2" Width="5" Height="32" CornerRadius="2.5" Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{Binding Id, Converter={StaticResource MenuColorConverter}}" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <!-- 未送出：名稱直接可改，Enter 或離開輸入框時儲存 -->
                                            <ui:TextBox Text="{Binding Name, Mode=OneWay}" MinWidth="260" MaxLength="100"
                                                        PlaceholderText="菜單名稱" VerticalAlignment="Center" FontSize="15"
                                                        ClearButtonEnabled="False"
                                                        KeyDown="MenuName_KeyDown" LostFocus="MenuName_LostFocus"
                                                        Visibility="{Binding IsSend, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                            <!-- 已送出：只顯示名稱 -->
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                                       Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Border Background="Green" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="已生成估價單" Foreground="White" FontSize="11" />
                                            </Border>
                                            <!-- 放在名稱旁邊，離右側的展開箭頭遠一點，避免想收合卡片時誤按 -->
                                            <ui:Button Icon="{ui:SymbolIcon Delete24}" ToolTip="刪除菜單" Appearance="Danger" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Command="{Binding DataContext.DeleteMenuCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <!-- 收合時也看得到的摘要：商品數、總金額、最後修改。平常在標題列中間；
                                             清單太窄（例如開著 AI 面板）時移到名稱下面，避免日期被截掉。用 WrapPanel：再窄也只會換行，不會被切掉 -->
                                        <!-- 每段各自一個 TextBlock：同一個 TextBlock 裡混粗體 Run 時，英數字會改用別的字型而顯得比較小 -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <WrapPanel.Style>
                                                <Style TargetType="WrapPanel">
                                                    <Setter Property="Grid.Column" Value="2" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="Margin" Value="16,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompactMenuHeader, RelativeSource={RelativeSource AncestorType=Page}}" Value="True">
                                                            <Setter Property="Grid.Row" Value="1" />
                                                            <Setter Property="Grid.Column" Value="1" />
                                                            <Setter Property="Grid.ColumnSpan" Value="3" />
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Setter Property="Margin" Value="0,6,0,0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </WrapPanel.Style>
                                            <TextBlock Text="{Binding TotalQty, StringFormat='{}{0} 項商品'}" Opacity="0.8" />
                                            <TextBlock Text="·" Opacity="0.8" Margin="8,0" />
                                            <TextBlock Text="{Binding TotalPrice, StringFormat='${0:N0}'}" FontWeight="SemiBold" />
                                            <TextBlock Text="·" Opacity="0.8" Margin="8,0" />
                                            <TextBlock Text="{Binding ReviseDate, StringFormat='最後修改 {0:yyyy/MM/dd HH:mm}'}" Opacity="0.8" />
                                        </WrapPanel>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <ui:Button Icon="{ui:SymbolIcon Open24}" ToolTip="開啟估價網頁"
                                                       Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding HtmUrl}"
                                                       Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ui:Button Icon="{ui:SymbolIcon Image24}" ToolTip="開啟估價圖片" Margin="4,0,0,0"
                                                       Command="{Binding DataContext.OpenExternalLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding PngUrl}"
                                                       Visibility="{Binding IsSend, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander.Header>

                                <StackPanel>
                                    <TextBlock Text="此菜單尚無商品，到首頁的商品表格輸入數量，或從左邊的零件暫存區拖進來" Opacity="0.6" HorizontalAlignment="Center" Margin="0,8"
                                               TextWrapping="Wrap" TextAlignment="Center"
                                               Visibility="{Binding HasProducts, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{Binding MyMenuProducts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 商品分類：維持 Expander 外觀，但固定展開、沒有收合功能與箭頭（StaticExpanderStyle） -->
                                                <Expander Header="{Binding Key}" Margin="0,4" Style="{StaticResource StaticExpanderStyle}">
                                                    <ItemsControl ItemsSource="{Binding Value}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <!-- 未送出菜單的商品可以拖到左邊的零件暫存區：整列都能拖（輸入框、按鈕、商品連結除外），
                                                                     Background 透明才接得到空白處的滑鼠；已送出的菜單由 MenuView 判斷不開始拖曳 -->
                                                                <Grid Margin="0,4" Background="Transparent"
                                                                      PreviewMouseLeftButtonDown="DragSource_PreviewMouseLeftButtonDown" MouseMove="DragSource_MouseMove">
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Style.Triggers>
                                                                                <!-- 未生成估價單的菜單，商品可以拖曳：顯示手掌游標 -->
                                                                                <DataTrigger Binding="{Binding DataContext.IsSend, RelativeSource={RelativeSource AncestorType=ui:CardExpander}}" Value="False">
                                                                                    <Setter Property="Cursor" Value="{x:Static views:MenuView.GrabCursor}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <ui:SymbolIcon Grid.Column="0" Symbol="ReOrderDotsVertical24" Opacity="0.4" Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center" ToolTip="拖曳到左邊的零件暫存區"
                                                                                   Visibility="{Binding DataContext.IsSend, RelativeSource={RelativeSource AncestorType=ui:CardExpander}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center">
                                                                        <Hyperlink Style="{StaticResource ProductLinkStyle}"
                                                                                   Command="{Binding DataContext.OpenProductLinkCommand, RelativeSource={RelativeSource AncestorType=Page}}">
                                                                            <Run Text="{Binding ProductName, Mode=OneWay}" />
                                                                        </Hyperlink>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" Text="{Binding ProductPrice, StringFormat='${0:N0}'}" Margin="8,0" VerticalAlignment="Center" />
                                                                    <!-- 單向綁定已儲存的數量：ValueChanged 時新值與它不同才代表使用者真的改了 -->
                                                                    <ui:NumberBox Grid.Column="3" Width="110" Value="{Binding Qty, Mode=OneWay}" Minimum="1"
                                                                                  ClearButtonEnabled="False" Tag="{Binding}"
                                                                                  ValueChanged="MenuItemQty_ValueChanged"
                                                                                  IsEnabled="{Binding DataContext.IsSend, RelativeSource={RelativeSource AncestorType=ui:CardExpander}, Converter={StaticResource InverseBoolConverter}}" />
                                                                    <!-- 拖曳以外的另一種方式（觸控板、鍵盤也能操作） -->
                                                                    <ui:Button Grid.Column="4" Icon="{ui:SymbolIcon ArrowExportRtl24}" ToolTip="移到零件暫存區"
                                                                               AutomationProperties.Name="移到零件暫存區" Margin="8,0,0,0"
                                                                               Command="{Binding DataContext.MoveToStagingCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                               CommandParameter="{Binding}"
                                                                               Visibility="{Binding DataContext.IsSend, RelativeSource={RelativeSource AncestorType=ui:CardExpander}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                    <ui:Button Grid.Column="5" Icon="{ui:SymbolIcon Delete24}" ToolTip="從菜單移除"
                                                                               AutomationProperties.Name="從菜單移除" Appearance="Danger" Margin="4,0,0,0"
                                                                               Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                               CommandParameter="{Binding}"
                                                                               Visibility="{Binding DataContext.IsSend, RelativeSource={RelativeSource AncestorType=ui:CardExpander}, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,8" />

                                    <!-- 底部：左邊生成估價單、右邊總金額（商品數與最後修改已移到標題列） -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="24" Height="24" HorizontalAlignment="Left"
                                                         Visibility="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <StackPanel Grid.Column="0"
                                                    Visibility="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <ui:Button Content="生成估價單" Icon="{ui:SymbolIcon Send24}"
                                                       Command="{Binding DataContext.SendMenuCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                       CommandParameter="{Binding Id}"
                                                       IsEnabled="{Binding HasProducts}"
                                                       Visibility="{Binding IsSend, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="總計" Opacity="0.7" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TotalPrice, StringFormat='${0:N0}'}" Margin="8,0,0,0" FontSize="16"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ui:CardExpander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
