<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!-- 發佈成單一個 PCBuilder.exe：自帶 .NET 執行環境，使用者雙擊就能用，不必另外安裝 .NET。
     Visual Studio：專案按右鍵「發佈」選這個設定檔；命令列：dotnet publish -p:PublishProfile=FolderProfile -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- 放在 bin 底下（已被 .gitignore 排除），exe 不會被誤 commit 進 repo -->
    <PublishDir>bin\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 自帶 .NET 執行環境：使用者電腦不必安裝 .NET 10 Desktop Runtime -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLite、WebView2 載入器等原生元件也包進 exe（執行時解到 %TEMP%\.net\PCBuilder），否則會散在 exe 旁邊 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 壓縮後約 69 MB（不壓縮約 153 MB），代價是啟動時要先解壓 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 不輸出 .pdb 偵錯符號 -->
    <DebugType>none</DebugType>
    <!-- 不複製套件附帶的 .xml 說明文件（WebView2 有 3 個）；空值會被 MSBuild 換回預設，所以填一個不存在的副檔名 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
